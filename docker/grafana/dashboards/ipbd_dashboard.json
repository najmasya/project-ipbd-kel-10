{
  "title": "IPBD Monitoring Dashboard",
  "uid": "ipbd-dashboard",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage (%)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "PCC52D03280B7034C" },
          "rawSql": "SELECT recorded_at AS time, cpu_percent FROM resource_metrics ORDER BY recorded_at ASC",
          "format": "table"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage (%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "PCC52D03280B7034C" },
          "rawSql": "SELECT recorded_at AS time, memory_percent FROM resource_metrics ORDER BY recorded_at ASC",
          "format": "table"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Usage (%)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "PCC52D03280B7034C" },
          "rawSql": "SELECT recorded_at AS time, disk_percent FROM resource_metrics ORDER BY recorded_at ASC",
          "format": "table"
        }
      ]
    },
    {
      "type": "table",
      "title": "Pipeline Execution Logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "PCC52D03280B7034C" },
          "rawSql": "SELECT started_at as time, pipeline_name, status, severity, message FROM pipeline_logs ORDER BY started_at DESC LIMIT 100",
          "format": "table"
        }
      ]
    }
