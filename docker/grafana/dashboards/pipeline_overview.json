{
  "title": "Pipeline Monitoring",
  "uid": "pipeline-monitoring-v6",
  "version": 1,
  "tags": ["ipbd"],
  "refresh": "30s",
  "schemaVersion": 38,
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1, "title": "Total Pipeline Runs (24h)", "type": "stat",
      "gridPos": { "h": 3, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM pipeline_logs WHERE started_at >= NOW() - INTERVAL '24 hours'", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 2, "title": "Failed Runs (24h)", "type": "stat",
      "gridPos": { "h": 3, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM pipeline_logs WHERE status = 'failed' AND started_at >= NOW() - INTERVAL '24 hours'", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] } } }
    },

    {
      "id": 4, "title": "Pipeline Status", "type": "stat",
      "gridPos": { "h": 3, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "table", "rawSql": "SELECT pipeline_status AS value FROM dashboard_metrics ORDER BY metric_date DESC LIMIT 1", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 5, "title": "Pipeline Status per Hari", "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "table", "rawSql": "SELECT DATE_TRUNC('day', started_at) AS time, status, COUNT(*) AS value FROM pipeline_logs WHERE started_at >= NOW() - INTERVAL '7 days' GROUP BY 1, 2 ORDER BY 1", "refId": "A" }],
      "options": { "orientation": "vertical", "xTickLabelRotation": -45, "xTickLabelSpacing": 0, "showValue": "auto", "stacking": "normal", "groupWidth": 0.7, "barWidth": 0.8, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 6, "title": "Pipeline Executions (7 Days)", "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "table", "rawSql": "SELECT CASE WHEN pipeline_name IN ('ingest_inflasi','ingest_kurs','ingest_emas') THEN 'batch_pipeline' ELSE pipeline_name END AS metric, COUNT(*) AS value FROM pipeline_logs WHERE started_at >= NOW() - INTERVAL '7 days' GROUP BY 1 ORDER BY 2 DESC", "refId": "A" }],
      "options": { "orientation": "horizontal", "stacking": "normal", "showValue": "auto", "groupWidth": 0.7, "barWidth": 0.8, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 7, "title": "Execution Duration (ms)", "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "table", "rawSql": "SELECT pipeline_name AS metric, AVG(duration_ms) AS value FROM pipeline_logs WHERE started_at >= NOW() - INTERVAL '7 days' AND duration_ms > 0 AND pipeline_name != 'stream_ingest' GROUP BY pipeline_name ORDER BY value DESC", "refId": "A" }],
      "options": { "orientation": "horizontal", "stacking": "normal", "showValue": "auto", "groupWidth": 0.7, "barWidth": 0.8, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false } },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 8, "title": "Severity Distribution (7 Days)", "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "table", "rawSql": "SELECT COALESCE(severity, 'NONE') AS metric, COUNT(*) AS value FROM pipeline_logs WHERE started_at >= NOW() - INTERVAL '7 days' GROUP BY severity ORDER BY value DESC", "refId": "A" }],
      "options": { "pieType": "pie", "displayLabels": ["name", "value", "percent"], "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 9, "title": "CPU Usage %", "type": "timeseries",
      "timeFrom": "now-24h",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 19 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "time_series", "rawSql": "SELECT recorded_at AS time, cpu_percent AS value FROM resource_metrics WHERE recorded_at >= NOW() - INTERVAL '24 hours' ORDER BY recorded_at", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 20, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 10, "title": "Memory Usage %", "type": "timeseries",
      "timeFrom": "now-24h",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 19 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "time_series", "rawSql": "SELECT recorded_at AS time, memory_percent AS value FROM resource_metrics WHERE recorded_at >= NOW() - INTERVAL '24 hours' ORDER BY recorded_at", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 20, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 11, "title": "Disk Usage %", "type": "timeseries",
      "timeFrom": "now-24h",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 19 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "time_series", "rawSql": "SELECT recorded_at AS time, disk_percent AS value FROM resource_metrics WHERE recorded_at >= NOW() - INTERVAL '24 hours' ORDER BY recorded_at", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 20, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } } }
    },
    {
      "id": 12, "title": "Recent Pipeline Logs", "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "targets": [{ "datasource": { "type": "grafana-postgresql-datasource", "uid": "PCC52D03280B7034C" }, "format": "table", "rawSql": "SELECT started_at AS time, pipeline_name, COALESCE(task_name, '-') AS task, status, COALESCE(severity, '-') AS severity, message, records_count, duration_ms FROM pipeline_logs ORDER BY started_at DESC LIMIT 50", "refId": "A" }],
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } }, "overrides": [
        { "matcher": { "id": "byName", "options": "severity" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }] },
        { "matcher": { "id": "byName", "options": "status" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }] }
      ] }
    }
  ]
}
